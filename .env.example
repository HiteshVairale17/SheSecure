# Supabase Configuration: Required for SheSecure Authentication and PostgreSQL Database.
# Obtain these from your Supabase Dashboard: Project Settings -> API.
# SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
# SUPABASE_ANON_KEY: anon / public API key (safe for client application use)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
