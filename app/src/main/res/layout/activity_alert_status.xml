<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_neutral">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Test Mode Notice Banner (Visible only in Test SOS) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_test_mode_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/status_warning_amber"
            app:cardBackgroundColor="@color/status_warning_tint">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/status_warning_amber"
                    android:contentDescription="Test Mode" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEST SOS SIMULATION ACTIVE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_warning_amber" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No actual cellular SMS was dispatched to emergency contacts."
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Top Status Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_shield_alert"
                app:tint="@color/emergency_red"
                android:contentDescription="Emergency" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_alert_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alert_status_completed"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_navy" />

                <TextView
                    android:id="@+id/tv_alert_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Triggered at Just Now"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Location Status Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SheSecure.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/status_active_green"
                        android:contentDescription="Location" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS Location Status"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_location_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Location coordinates attached:\nhttps://maps.google.com/?q=37.7749,-122.4194"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Message Preview Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SheSecure.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prepared Emergency Text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tv_message_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY: Sarah needs help! Current location: https://maps.google.com/?q=37.7749,-122.4194 (Sent via SheSecure)"
                    android:textSize="13sp"
                    android:textColor="@color/slate_surface"
                    android:background="@color/surface_neutral"
                    android:padding="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recipients Outcome Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SheSecure.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Alert Delivery Log"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_contacts_outcome_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preparing alert dispatch…"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_delivery_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Note: Status updates to 'Sent' once your carrier network acknowledges receipt. Handset delivery reports depend on carrier and recipient network support."
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fallback Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sms_fallback"
            style="@style/Widget.SheSecure.Button.Emergency"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_open_sms_fallback"
            app:icon="@drawable/ic_sms"
            app:iconTint="@color/white"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_return_dashboard"
            style="@style/Widget.SheSecure.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_return_dashboard" />
    </LinearLayout>
</ScrollView>
