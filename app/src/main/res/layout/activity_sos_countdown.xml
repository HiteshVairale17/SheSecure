<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/emergency_tint"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Top Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Warning Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_shield_alert"
        app:tint="@color/emergency_red"
        android:contentDescription="Emergency" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/countdown_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/emergency_red_dark"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.04" />

    <TextView
        android:id="@+id/tv_countdown_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/countdown_subtitle"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:layout_marginTop="8dp" />

    <!-- Big Countdown Number -->
    <TextView
        android:id="@+id/tv_countdown_seconds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5"
        android:textSize="96sp"
        android:textStyle="bold"
        android:textColor="@color/emergency_red"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/countdown_progress"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progress="100"
        android:max="5000"
        app:indicatorColor="@color/emergency_red"
        app:trackColor="@color/card_border"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Press cancel below if triggered accidentally."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <!-- Bottom Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_alert"
        style="@style/Widget.SheSecure.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_cancel_sos"
        android:textSize="16sp"
        android:backgroundTint="@color/primary_navy"
        android:layout_marginBottom="16dp" />
</LinearLayout>
